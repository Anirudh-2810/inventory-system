# StockOffline Environment Variables
# Copy this file to .env and fill in the values

# Required: Path to the SQLite database file (must be set, or the app refuses to start)
INVENTORY_DB_PATH=./inventory.db

# Required (security): Secret for JWT signing. Generate a long random string!
# If missing or left as the placeholder, the web tier refuses to start.
JWT_SECRET_KEY=replace-with-strong-random-secret

# Payments: Webhook signing secrets (only needed if payments are enabled).
# If unset, webhook signature verification fails closed (requests are rejected).
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret

# Web server bind address/port (optional). Defaults shown.
# Bind to 127.0.0.1 by default; only expose via a reverse proxy + TLS in production.
WEB_HOST=127.0.0.1
WEB_PORT=8000

# CORS: comma-separated list of exact frontend origins allowed to call the API.
# Example: http://localhost:3000,https://app.stockoffline.com
# If empty, no cross-origin requests are permitted (same-origin only).
ALLOWED_ORIGINS=

# Optional: Debug mode. MUST be false in production.
DEBUG=false

# Optional: Log level (DEBUG, INFO, WARNING, ERROR). Defaults to INFO.
LOG_LEVEL=INFO
